# 复制为 .env 后再修改密码；不要提交真实 .env。
MYSQL_DATABASE=scanner
MYSQL_USER=scanner
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
WEB_PORT=8080

DATABASE_URL=mysql+pymysql://scanner:change-me@127.0.0.1:3306/scanner?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://scanner:change-me@127.0.0.1:3306/scanner_test?charset=utf8mb4
APP_ENV=development
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ALLOWED_ORIGINS=http://localhost:8080

# 简道云接口联调 Demo；真实 API Key 仅在本机环境变量中配置，不要提交。
JIANDAOYUN_CREATE_URL=
JIANDAOYUN_APP_ID=
JIANDAOYUN_ENTRY_ID=
JIANDAOYUN_API_KEY=
